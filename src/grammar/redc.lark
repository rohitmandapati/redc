start: top_level+

?top_level: const_decl | function

const_decl: "const" type NAME "=" expr ";"

function: type NAME "(" parameters? ")" block
parameters: parameter ("," parameter)*
parameter: type NAME

block: "{" statement* "}"

?statement: var_decl
          | assignment
          | for_stmt
          | return_stmt

var_decl: type NAME "=" expr ";"
assignment: NAME "=" expr ";"
return_stmt: "return" expr ";"

for_stmt: "for" "(" for_init ";" expr ";" assignment_expr ")" block
?for_init: var_init | assignment_expr
var_init: type NAME "=" expr
assignment_expr: NAME "=" expr

?expr: comparison

?comparison: sum "<" sum -> less_than
           | sum

?sum: sum "+" atom -> add
    | atom

?atom: INT          -> integer
     | NAME         -> variable
     | "(" expr ")"

type: "uint8" -> uint8_type

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

%import common.INT
%import common.WS
%ignore WS
%ignore /\/\/[^\n]*/